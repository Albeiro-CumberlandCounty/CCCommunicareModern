---
interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
---

<a class:list={['brand-logo', className]} href={href} aria-label="CommuniCare home">
  <img
    src="/brand/communicare-header-logo.svg"
    alt=""
    width="1999"
    height="1403"
    decoding="async"
  />
</a>
