---
interface Props {
  title: string;
  href: string;
  symbol: 'services' | 'help' | 'contact' | 'resources';
}
const { title, href, symbol } = Astro.props;
const symbols = {
  services: 'M4 7h16M4 12h16M4 17h12',
  help: 'M12 3a9 9 0 1 0 9 9M12 8v4m0 4h.01',
  contact: 'M7 4h10l3 4v11H4V8l3-4zM4 9h16M8 14h8',
  resources: 'M5 4h12a2 2 0 0 1 2 2v14H7a2 2 0 0 0-2 0zM5 4v16'
};
---
<a class="institutional-quick-card" href={href}>
  <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={symbols[symbol]} /></svg>
  <span>{title}</span>
  <span aria-hidden="true" class="institutional-quick-card__arrow">→</span>
</a>
