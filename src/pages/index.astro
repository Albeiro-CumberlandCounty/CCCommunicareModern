---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceAreas = [
  'Juvenile Assessment Center',
  'FACT',
  'Intensive Services Network',
  'Reclaiming Futures',
  'PEACE Project Domestic Violence Intervention Program',
  'Tailored Care Management Services',
  'Community Based Capacity Restoration Program',
  'Skill Building Classes'
];
---

<BaseLayout
  title="Home"
  canonicalPath="/"
  description="Cumberland County CommuniCare provides behavioral health services, early intervention, prevention, and family support to children, adolescents, adults, and families."
>
  <!-- Editorial source: Website Redesign 10.docx; copy remains verbatim. -->
  <section class="editorial-hero" aria-labelledby="home-welcome">
    <div class="container editorial-hero__grid">
      <div>
        <p class="eyebrow">Welcome to Cumberland County CommuniCare</p>
        <h1 id="home-welcome">Strengthening Individuals. Empowering Families. Building a Healthier Community.</h1>
        <p class="editorial-hero__tagline">Compassionate Care. Proven Experience. Community Commitment.</p>
        <p>For more than 28 years, Cumberland County CommuniCare, Inc. has been a trusted community partner, providing comprehensive behavioral health services, early intervention, prevention, and family support to children, adolescents, adults, and families throughout Cumberland County and surrounding communities.</p>
        <div class="actions">
          <a class="button button--primary" href="/programs-services/">Explore Programs &amp; Services</a>
          <a class="button button--secondary" href="/referrals/">Get Help &amp; Referrals</a>
        </div>
      </div>
      <aside class="editorial-hero__side" aria-labelledby="hero-access-heading">
        <p class="eyebrow">Welcome to CommuniCare</p>
        <h2 id="hero-access-heading">Because Access to Care Shouldn't Depend on Your Ability to Pay.</h2>
        <p>What distinguishes CommuniCare is not simply the services we provide, but our commitment to reaching individuals and families who might otherwise go without the support they need. Through publicly funded programs and community partnerships, we work to reduce financial and systemic barriers to care, expanding access for eligible individuals who are uninsured or underinsured.</p>
        <a href="/contact/" class="text-link">Contact CommuniCare</a>
      </aside>
    </div>
  </section>

  <!-- Sequence section 02. Statistics deliberately omitted until verified and approved. -->
  <section class="editorial-section editorial-section--light" aria-labelledby="impact-heading">
    <div class="container editorial-split">
      <div class="editorial-section__intro">
        <p class="eyebrow">CommuniCare at a Glance</p>
        <h2 id="impact-heading">Our Commitment. Our Work. Our Impact.</h2>
        <p class="editorial-section__lead">Every number represents an individual, a family, or an opportunity to make a meaningful difference.</p>
      </div>
      <div class="editorial-section__body">
        <p>At CommuniCare, we measure our contributions not simply by the number of services delivered, but by our ability to respond to community needs, expand access to care, and support individuals and families facing complex challenges.</p>
        <p>From early intervention and behavioral health treatment to care coordination and specialized community-based programs, our work reflects an ongoing investment in the health, stability, and well-being of Cumberland County.</p>
      </div>
    </div>
  </section>

  <!-- Sequence section 03. The eight service-area names were separately confirmed in M3. -->
  <section class="editorial-section editorial-section--blue" aria-labelledby="programs-heading">
    <div class="container">
      <div class="editorial-heading">
        <p class="eyebrow">Programs &amp; Services</p>
        <h2 id="programs-heading">Comprehensive Services. Individualized Support. Community-Based Solutions.</h2>
        <p>The challenges facing individuals and families rarely exist in isolation. Behavioral health concerns, family instability, educational difficulties, substance use, involvement with the justice system, and barriers to accessing essential resources often intersect, requiring coordinated and responsive approaches to care.</p>
        <p>CommuniCare offers a diverse range of clinical, preventive, rehabilitative, and supportive services designed to address these interconnected needs. Our programs emphasize early identification, individualized intervention, family engagement, and collaboration with the community systems that influence long-term stability and well-being.</p>
        <p>Whether providing direct behavioral health treatment, supporting youth and families during periods of crisis, coordinating services for individuals with complex needs, or partnering with courts and community agencies, our approach remains centered on helping people achieve meaningful and sustainable progress.</p>
      </div>
      <div class="editorial-program-grid">
        {serviceAreas.map((area) => (
          <div class="editorial-program-grid__item">{area}</div>
        ))}
      </div>
      <p class="editorial-section__closing">Explore our programs and services to learn how CommuniCare supports individuals, strengthens families, and contributes to healthier communities.</p>
      <a href="/programs-services/" class="button button--primary">View Programs &amp; Services</a>
    </div>
  </section>

  <!-- Sequence section 04. -->
  <section class="editorial-section editorial-section--light" aria-labelledby="approach-heading">
    <div class="container editorial-split">
      <div class="editorial-section__intro">
        <p class="eyebrow">What Makes CommuniCare Different</p>
        <h2 id="approach-heading">Meeting People Where They Are. Supporting Them Where They Want to Go.</h2>
      </div>
      <div class="editorial-section__body">
        <p>We recognize that behavioral health challenges rarely occur in isolation. Mental health conditions, substance use disorders, trauma, family instability, involvement with the justice system, and barriers to essential resources can significantly affect an individual's well-being and quality of life.</p>
        <p>CommuniCare responds to these challenges through an integrated, person-centered approach that addresses behavioral health needs while promoting resilience, personal accountability, family stability, and long-term success.</p>
        <div class="editorial-paths" aria-label="Explore CommuniCare">
          <a href="/about/">Who We Are <span aria-hidden="true">→</span></a>
          <a href="/programs-services/">Programs &amp; Services <span aria-hidden="true">→</span></a>
          <a href="/referrals/">Get Help &amp; Referrals <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sequence section 05; Website Redesign 10.docx supplies the exact paragraph. -->
  <section class="editorial-section editorial-section--partnerships" aria-labelledby="partners-heading">
    <div class="container editorial-split">
      <div class="editorial-section__intro">
        <p class="eyebrow">Partnerships &amp; Collaboration</p>
        <h2 id="partners-heading">Connecting Care, Community, and Opportunity.</h2>
      </div>
      <div class="editorial-section__body">
        <p>Through longstanding partnerships with local courts, schools, public agencies, healthcare organizations, and community stakeholders, CommuniCare helps bridge gaps in services, reduce barriers to treatment, and develop meaningful alternatives to deeper involvement in the justice system.</p>
        <p>We are especially committed to serving individuals and families who are vulnerable, underserved, uninsured, or facing circumstances that make accessing appropriate care difficult.</p>
      </div>
    </div>
  </section>

  <!-- Sequence section 06; contact methods are already approved in M3. -->
  <section class="editorial-section editorial-section--contact" aria-labelledby="home-contact-heading">
    <div class="container editorial-contact">
      <div>
        <p class="eyebrow">Contact &amp; Referrals</p>
        <h2 id="home-contact-heading">More Than Services. A Commitment to Our Community.</h2>
        <p>At CommuniCare, we believe every individual deserves access to compassionate support, meaningful opportunities, and the resources needed to build a healthier, more stable future.</p>
      </div>
      <div class="editorial-contact__actions">
        <a class="button button--primary" href="tel:+19108299017">Call 910-829-9017</a>
        <a class="button button--secondary" href="/referrals/">Get Help &amp; Referrals</a>
        <a class="text-link" href="/contact/">Contact CommuniCare</a>
      </div>
    </div>
  </section>
</BaseLayout>
