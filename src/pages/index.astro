---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" canonicalPath="/">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Cumberland County CommuniCare</p>
      <h1>Support for youth, adults & families starts here.</h1>
      <p class="lede">
        This is the new CommuniCare website foundation. Current program and organizational content is being validated with CommuniCare before launch.
      </p>
      <div class="actions">
        <a class="button button--primary" href="/programs-services/">Programs & Services</a>
        <a class="button button--secondary" href="/referrals/">Get Help / Referrals</a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container card-grid">
      <article class="card">
        <h2>Programs & Services</h2>
        <p>Explore the current program structure being prepared for the modern site.</p>
        <a href="/programs-services/">View Programs & Services</a>
      </article>
      <article class="card">
        <h2>Get Help</h2>
        <p>Learn how to contact CommuniCare and, once approved, start a secure referral through Laserfiche.</p>
        <a href="/referrals/">Referral information</a>
      </article>
      <article class="card">
        <h2>Contact</h2>
        <p>Find CommuniCare's approved address, phone number, and public contact information.</p>
        <a href="/contact/">Contact CommuniCare</a>
      </article>
    </div>
  </section>
</BaseLayout>
