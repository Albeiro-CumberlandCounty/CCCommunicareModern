---
import BaseLayout from '../layouts/BaseLayout.astro';

const confirmedPrograms = [
  'Juvenile Assessment Center',
  'FACT',
  'Intensive Services Network',
  'Reclaiming Futures',
  'PEACE Project Domestic Violence Intervention Program',
  'Tailored Care Management Services',
  'Community Based Capacity Restoration Program',
  'Skill Building Classes'
];
---

<BaseLayout title="Programs & Services" canonicalPath="/programs-services/">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Programs & Services</p>
      <h1>Current services, organized clearly.</h1>
      <p class="lede">The pages below are the confirmed program/service areas being prepared for the modern site. Final descriptions are pending updated CommuniCare content.</p>
    </div>
  </section>
  <section class="section section--surface">
    <div class="container card-grid">
      {confirmedPrograms.map((program) => (
        <article class="card">
          <h2>{program}</h2>
          <p>Updated program content is being prepared and will be published after content-owner review.</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
