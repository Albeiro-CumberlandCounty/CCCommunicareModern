---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get Help / Referrals" canonicalPath="/referrals/">
  <section class="page-hero">
    <div class="container prose">
      <p class="eyebrow">Get Help</p>
      <h1>Referrals</h1>
      <p class="lede">To ask about services or start the referral process, contact CommuniCare by phone or email.</p>
      <div class="actions">
        <a class="button button--primary" href="tel:+19108299017">Call 910-829-9017</a>
        <a class="button button--secondary" href="mailto:referrals@cccommunicare.org">Email Referrals</a>
      </div>
    </div>
  </section>
  <section class="section section--surface" id="start-referral">
    <div class="container prose">
      <h2>Start a secure referral</h2>
      <div class="notice">
        The approved referral form will be rebuilt in Cumberland County Laserfiche Forms. The secure form will be embedded or linked here after the updated form and workflow are approved.
      </div>
    </div>
  </section>
</BaseLayout>
